// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  ADMIN
}

model User {
  id            String   @id @default(uuid())
  fullName      String
  email         String   @unique
  phone         String?  @unique
  password      String
  role          Role     @default(USER)
  emailVerified Boolean  @default(false)
  phoneVerified Boolean  @default(false)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  projects Project[]
}

// Define the Project model

model Project {
  id          String   @id @default(uuid())
  userId      String
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  apis Api[]

  @@unique([userId, name])
}

// Define the Api modal and HTTP methods as an enum

enum HttpMethod {
  GET
  POST
  PUT
  DELETE
  PATCH
  HEAD
  OPTIONS
}

enum AuthType {
  NONE
  BEARER_TOKEN
  API_KEY
  BASIC_AUTH
  CUSTOM_HEADER
}

model Api {
  id                  String     @id @default(uuid())
  projectId           String
  title               String
  url                 String
  method              HttpMethod
  intervalMinutes     Int        @default(5) // User can choose: 1, 5, 10, 15, 30, 60
  expectedStatusCodes Int[]      @default([200])
  isActive            Boolean    @default(true)
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt

  // Authentication fields
  authType        AuthType @default(NONE)
  authToken       String? // For Bearer token or API key value
  authHeaderName  String? // Custom header name (e.g., "X-API-Key", "Authorization")
  authHeaderValue String? // Custom header value
  username        String? // For Basic Auth
  password        String? // For Basic Auth

  // Optional health check endpoint for monitoring
  healthCheckUrl String? // If provided, use this for monitoring instead of guessing

  // Monitoring status fields
  currentStatus      ApiStatus? @default(UP) // Current status of the API
  lastCheckedAt      DateTime?  @default(now()) // When was the API last checked
  lastResponseTimeMs Int? // Last response time in milliseconds
  failureCount       Int        @default(0) // Number of consecutive failures

  project Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  logs    ApiCheckLog[]

  @@unique([projectId, url, method])
}

// Define the ApiCheckLog model and ApiStatus enum

enum ApiStatus {
  UP
  DOWN
}

model ApiCheckLog {
  id             String    @id @default(uuid())
  apiId          String
  status         ApiStatus
  statusCode     Int
  responseTimeMs Int
  checkedAt      DateTime  @default(now())

  api Api @relation(fields: [apiId], references: [id], onDelete: Cascade)

  @@index([apiId])
  @@index([checkedAt])
}

model Waitlist {
  id String @id @default(uuid())
  email String @unique
  createdAt DateTime @default(now())
}
